{
    "compilerOptions": {
        "target": "es2022",
        "outDir": "dist",
        "declaration": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "lib": ["es7", "esnext"],
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "newLine": "LF"
    },
    "include": ["src/**/*"],
    "exclude": ["dist"]
}
