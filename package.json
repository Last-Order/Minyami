        "https-proxy-agent": "^7.0.4",
        "socks-proxy-agent": "^8.0.2",
        "winreg": "^1.2.5"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.1",
        "husky": "^7.0.2",
        "jest": "^30.4.2",
        "lint-staged": "^11.1.2",
        "prettier": "^2.3.2",
        "ts-jest": "^29.4.12",
