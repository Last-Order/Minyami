        "test:coverage": "jest --coverage",
        "lint": "prettier ./src/**/* ./test/**/* ./jest.config.js ./tsconfig*.json ./.github/workflows/*.yml --check",
        "lint-fix": "prettier ./src/**/* ./test/**/* ./jest.config.js ./tsconfig*.json ./.github/workflows/*.yml --write",
        "prepare": "husky install"
    },
    "bin": {
        "minyami": "./dist/index.js"
    },
    "files": [
        "/dist/"
    ],
    "engines": {
